ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI provider. Leave all four blank for the default: Anthropic Claude Haiku
# authenticated with ANTHROPIC_API_KEY above.
#   AI_PROVIDER  anthropic | openai_compatible   (default: anthropic)
#   AI_MODEL     model id                        (default: claude-haiku-4-5-20251001)
#   AI_BASE_URL  optional baseURL override for anthropic; REQUIRED for openai_compatible
#   AI_API_KEY   optional; falls back to ANTHROPIC_API_KEY for anthropic,
#                REQUIRED for openai_compatible
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Example: an OpenAI-compatible endpoint such as Kimi / Moonshot. Verify
# Moonshot's current protocol + base URL in their docs before use — do not
# assume the values below are still correct.
# AI_PROVIDER=openai_compatible
# AI_MODEL=kimi-k2-0711-preview
# AI_BASE_URL=https://api.moonshot.ai/v1
# AI_API_KEY=your-moonshot-api-key-here

AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fantasy_nba
# Optional. Only scraper/run_scraper.py and scraper/check_migrations.py read
# this, and only when passed --dev.
# Neon console -> Branches -> dev -> Connection string.
DATABASE_URL_DEV=
FRONTEND_URL=http://localhost:5173
FROM_EMAIL=
GOOGLE_CLIENT_ID=
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
